# Shared JWT signing secret (Base64-encoded, min 256-bit). All services must use the same value.
# REQUIRED — there is no built-in default: the services (and docker-compose) refuse to start
# without it. For local dev, copy this file to .env (gitignored) and keep your own value there;
# deployed environments inject JWT_SECRET as a platform env var. Generate one with:
#   openssl rand -base64 48
# The value below is a LOCAL-DEV EXAMPLE only — never use it in a real deployment.
JWT_SECRET=c3ByaW5nLWJvb3QtdXNlci1zZXJ2aWNlLWxvY2FsLWRldmVsb3BtZW50LXNlY3JldC0yMDI2
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-local-development-secret
REDIS_SSL=false
REDIS_TIMEOUT=2s
