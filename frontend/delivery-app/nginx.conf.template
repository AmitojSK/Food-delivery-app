server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;

    location /user-api/ {
        proxy_pass ${API_GATEWAY_URL}/user-api/;
    }

    location /delivery-api/ {
        proxy_pass ${API_GATEWAY_URL}/delivery-api/;
    }

    # Server-Sent Events stream for live delivery-board updates: disable proxy buffering
    # and keep the upstream connection open so events reach the browser as they happen.
    location /realtime-api/ {
        proxy_pass ${API_GATEWAY_URL}/realtime-api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location /order-api/ {
        proxy_pass ${API_GATEWAY_URL}/order-api/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
