server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    # Forward the real client IP so the gateway can rate-limit per client (not per frontend).
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;

    location /user-api/ {
        proxy_pass ${API_GATEWAY_URL}/user-api/;
    }

    location /restaurant-api/ {
        proxy_pass ${API_GATEWAY_URL}/restaurant-api/;
    }

    location /catalogue-api/ {
        proxy_pass ${API_GATEWAY_URL}/catalogue-api/;
    }

    location /order-api/ {
        proxy_pass ${API_GATEWAY_URL}/order-api/;
    }

    # Live delivery tracking (driver location for the customer's map).
    location /delivery-api/ {
        proxy_pass ${API_GATEWAY_URL}/delivery-api/;
    }

    # Server-Sent Events stream for live order updates: disable proxy buffering and
    # keep the upstream connection open so events reach the browser as they happen.
    location /realtime-api/ {
        proxy_pass ${API_GATEWAY_URL}/realtime-api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
